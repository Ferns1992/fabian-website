# Content-hashed bundles: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable filenames, so a week rather than a year.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/og-image.jpg
  Cache-Control: public, max-age=604800
/profile.webp
  Cache-Control: public, max-age=604800
/about.webp
  Cache-Control: public, max-age=604800
